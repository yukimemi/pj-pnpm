# renri.toml — fresh worktrees refresh agent skills, install
# Node deps, and fetch upstream so the new worktree is
# rebase-ready in one go. Ordering matters: `apm install --update`
# first (so the latest renri skill is in place before anything
# else runs), then `pnpm install` (so node_modules are ready
# before the consumer hits any local script), then `vcs-fetch`
# (best-effort remote refresh).
# Schema and examples: https://github.com/yukimemi/renri

[[hooks.post_create]]
type = "command"
run = "apm install --update -t copilot,claude,gemini"
shell = "auto"

[[hooks.post_create]]
type = "command"
run = "pnpm install"
shell = "auto"

[[hooks.post_create]]
type = "command"
# Best-effort: a missing remote / no upstream / pure-jj workspace
# without a git remote shouldn't break `renri add`.
run = "git fetch || true"
shell = "auto"
